# WhatsApp (só números, com DDI + DDD, sem espaços/símbolos)
NEXT_PUBLIC_WHATSAPP_NUMBER=5551980602183

# URL final do site, usada pra gerar o QR code (troque quando o domínio estiver no ar)
NEXT_PUBLIC_SITE_URL=https://pedrosiqueira.com.br

# TikTok — deixe ativo=false até ter conta criada
NEXT_PUBLIC_TIKTOK_ATIVO=false
NEXT_PUBLIC_TIKTOK_LINK=https://tiktok.com/@...

# Token que você mesmo escolhe, usado pra logar na página /admin
# Gere algo aleatório, ex: rode no terminal -> openssl rand -hex 16
ADMIN_TOKEN=troque-por-um-token-secreto

# As duas linhas abaixo são preenchidas automaticamente pela Vercel quando
# você conecta um banco Upstash Redis (Storage > Marketplace > Upstash >
# Redis) ao projeto. Não precisa copiar nada aqui manualmente — a Vercel
# injeta sozinha.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
